# Salin ke .env: cp .env.example .env
# Jangan commit file .env ke GitHub.

# === Wajib di Railway (Variables) ===
# Neon PostgreSQL — https://console.neon.tech (Connection string → pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Generate: openssl rand -base64 32
SESSION_SECRET=

# WAJIB di Railway — jangan set ke "development" (akan memuat Vite & crash)
NODE_ENV=production

# Railway set PORT otomatis; untuk lokal:
PORT=3000

# === StarSender (notifikasi WA otomatis reservasi) ===
# Device API Key dari dashboard StarSender → Device → API Key
STARSENDER_API_KEY=
# true = kirim WA (wajib set API key). false = matikan meski key ada.
STARSENDER_ENABLED=true
# Opsional — default: https://starsender.online/api/sendText
# STARSENDER_API_URL=https://starsender.online/api/sendText
